{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-features"
    },
    {
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-features/index/status-created-index",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-features/index/status-votes-index",
        "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-features/index/author-index"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/roadhub-categories"
    },
    {
      "Effect": "Allow",
      "Action": "events:PutEvents",
      "Resource": "arn:aws:events:us-east-1:000000000000:event-bus/roadhub-events"
    },
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:roadhub/jwt-public-??????",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:roadhub/internal-??????",
        "arn:aws:secretsmanager:us-east-1:000000000000:secret:roadhub/turnstile-??????"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:000000000000:log-group:/roadhub/roadmap:log-stream:api-*"
    }
  ]
}
